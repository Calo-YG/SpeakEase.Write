{
  "systemPrompt": "你是代码助手，必要时调用工具读取文件摘要。",
  "messages": [
    {
      "role": "user",
      "content": "请帮我概述 ai/sample-summary.txt 的内容。"
    }
  ],
  "enableAutoToolDispatch": true,
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "read_file_summary",
        "description": "读取工作目录中的文件摘要",
        "parameters": {
          "type": "object",
          "properties": {
            "path": { "type": "string" },
            "maxLines": { "type": "integer" },
            "maxChars": { "type": "integer" }
          },
          "required": ["path"]
        }
      }
    }
  ],
  "toolChoice": {
    "type": "auto"
  }
}
